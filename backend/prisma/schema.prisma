generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum SettlementStatus {
  PENDING
  PAID
}

enum PaymentMethod {
  PROMPTPAY
  BANK_ACCOUNT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bills Bill[] @relation("BillOwner")
}

model Bill {
  id        String   @id @default(cuid())
  ownerId   String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner        User              @relation("BillOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  participants BillParticipant[]
  expenses     Expense[]
  settlements  Settlement[]

  @@index([ownerId])
}

model BillParticipant {
  id        String   @id @default(cuid())
  billId    String
  name      String
  createdAt DateTime @default(now())

  bill         Bill                 @relation(fields: [billId], references: [id], onDelete: Cascade)
  expensesPaid Expense[]            @relation("ExpensePayer")
  shares       ExpenseParticipant[]
  paymentInfo  PaymentInfo?

  @@index([billId])
}

model Expense {
  id                  String   @id @default(cuid())
  billId              String
  paidByParticipantId String
  description         String
  amountSatang        Int
  category            String
  spentAt             DateTime
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  bill         Bill                 @relation(fields: [billId], references: [id], onDelete: Cascade)
  paidBy       BillParticipant      @relation("ExpensePayer", fields: [paidByParticipantId], references: [id])
  participants ExpenseParticipant[]

  @@index([billId])
  @@index([paidByParticipantId])
  @@index([spentAt])
}

model ExpenseParticipant {
  id            String @id @default(cuid())
  expenseId     String
  participantId String

  expense     Expense         @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  participant BillParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([expenseId, participantId])
  @@index([participantId])
}

model PaymentInfo {
  id            String        @id @default(cuid())
  participantId String        @unique
  method        PaymentMethod

  promptPayId   String?
  bankName      String?
  accountName   String?
  accountNumber String?

  participant BillParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

model Settlement {
  id                String           @id @default(cuid())
  billId            String
  fromParticipantId String
  toParticipantId   String
  amountSatang      Int
  status            SettlementStatus @default(PENDING)
  shareToken        String           @unique
  createdAt         DateTime         @default(now())
  paidAt            DateTime?

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
  @@index([fromParticipantId])
  @@index([toParticipantId])
}
